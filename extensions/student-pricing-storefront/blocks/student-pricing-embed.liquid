{% assign request_path = request.path | downcase %}
{% assign is_bundle_access_page = false %}
{% assign bundle_product_handles = 'primary-years-bundle' %}
{% assign all_bundles_collection = collections['all-bundles'] %}

{% if all_bundles_collection and all_bundles_collection.products_count > 0 %}
  {% capture bundle_product_handles %}
    {% for product in all_bundles_collection.products %}
      {{ product.handle }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  {% endcapture %}
{% endif %}

{% if request_path contains '/products/primary-years-bundle' or request_path contains '/collections/all-bundles' or request_path contains '/collections/bundle' %}
  {% assign is_bundle_access_page = true %}
{% endif %}

{% if all_bundles_collection and all_bundles_collection.products_count > 0 %}
  {% for product in all_bundles_collection.products %}
    {% assign product_path = '/products/' | append: product.handle %}
    {% if request_path contains product_path %}
      {% assign is_bundle_access_page = true %}
    {% endif %}
  {% endfor %}
{% endif %}

{% unless customer %}
  <style>
    a[href*="/collections/all-bundles"],
    a[href*="/collections/bundle"],
    a[href*="/products/primary-years-bundle"],
    {% if all_bundles_collection and all_bundles_collection.products_count > 0 %}
      {% for product in all_bundles_collection.products %}
        a[href*="/products/{{ product.handle }}"],
        main li:has(a[href*="/products/{{ product.handle }}"]),
        main .grid__item:has(a[href*="/products/{{ product.handle }}"]),
        main [class*="grid__item"]:has(a[href*="/products/{{ product.handle }}"]),
        main [data-product-card]:has(a[href*="/products/{{ product.handle }}"]),
        main [data-card-wrapper]:has(a[href*="/products/{{ product.handle }}"]),
        #MainContent li:has(a[href*="/products/{{ product.handle }}"]),
        #MainContent .grid__item:has(a[href*="/products/{{ product.handle }}"]),
        #MainContent [class*="grid__item"]:has(a[href*="/products/{{ product.handle }}"]),
        #MainContent [data-product-card]:has(a[href*="/products/{{ product.handle }}"]),
        #MainContent [data-card-wrapper]:has(a[href*="/products/{{ product.handle }}"]),
      {% endfor %}
    {% endif %}
    main li:has(a[href*="/products/primary-years-bundle"]),
    main .grid__item:has(a[href*="/products/primary-years-bundle"]),
    main [class*="grid__item"]:has(a[href*="/products/primary-years-bundle"]),
    main [data-product-card]:has(a[href*="/products/primary-years-bundle"]),
    main [data-card-wrapper]:has(a[href*="/products/primary-years-bundle"]),
    #MainContent li:has(a[href*="/products/primary-years-bundle"]),
    #MainContent .grid__item:has(a[href*="/products/primary-years-bundle"]),
    #MainContent [class*="grid__item"]:has(a[href*="/products/primary-years-bundle"]),
    #MainContent [data-product-card]:has(a[href*="/products/primary-years-bundle"]),
    #MainContent [data-card-wrapper]:has(a[href*="/products/primary-years-bundle"]) {
      display: none !important;
    }
  </style>

  {% if is_bundle_access_page %}
    <script>
      window.location.replace('/');
    </script>
  {% endif %}
{% endunless %}

<div
  id="student-pricing-config-{{ block.id }}"
  class="student-pricing-config"
  hidden
  data-endpoint="/apps/student-automatic-discount/proxy/student-pricing"
  data-bundle-access-endpoint="/apps/student-automatic-discount/proxy/bundle-access"
  data-protected-product-handles="{{ bundle_product_handles | strip | replace: ' ', '' }}"
  data-protected-collection-handles="bundle,all-bundles"
  data-shop="{{ shop.myshopify_domain }}"
  data-customer-id="{{ customer.id | default: '' }}"
  data-design-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
></div>

{% schema %}
{
  "name": "Student pricing preview",
  "target": "body",
  "stylesheet": "student-pricing.css",
  "javascript": "student-pricing.js",
  "settings": []
}
{% endschema %}
