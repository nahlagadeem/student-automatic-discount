{% assign request_path = request.path | downcase %}
{% assign is_bundle_access_page = false %}

{% if request_path contains '/products/primary-years-bundle' or request_path contains '/collections/all-bundles' or request_path contains '/collections/bundle' %}
  {% assign is_bundle_access_page = true %}
{% endif %}

<style>
  html:not(.student-pricing-bundle-access-allowed) a[href*="/collections/all-bundles"],
  html:not(.student-pricing-bundle-access-allowed) a[href*="/collections/bundle"],
  html:not(.student-pricing-bundle-access-allowed) a[href*="/products/primary-years-bundle"] {
    display: none !important;
  }

  html:not(.student-pricing-bundle-access-allowed) li:has(a[href*="/collections/all-bundles"]),
  html:not(.student-pricing-bundle-access-allowed) li:has(a[href*="/collections/bundle"]),
  html:not(.student-pricing-bundle-access-allowed) li:has(a[href*="/products/primary-years-bundle"]),
  html:not(.student-pricing-bundle-access-allowed) .grid__item:has(a[href*="/collections/all-bundles"]),
  html:not(.student-pricing-bundle-access-allowed) .grid__item:has(a[href*="/collections/bundle"]),
  html:not(.student-pricing-bundle-access-allowed) .grid__item:has(a[href*="/products/primary-years-bundle"]),
  html:not(.student-pricing-bundle-access-allowed) [class*="grid__item"]:has(a[href*="/collections/all-bundles"]),
  html:not(.student-pricing-bundle-access-allowed) [class*="grid__item"]:has(a[href*="/collections/bundle"]),
  html:not(.student-pricing-bundle-access-allowed) [class*="grid__item"]:has(a[href*="/products/primary-years-bundle"]),
  html:not(.student-pricing-bundle-access-allowed) [data-product-card]:has(a[href*="/products/primary-years-bundle"]),
  html:not(.student-pricing-bundle-access-allowed) [data-card-wrapper]:has(a[href*="/products/primary-years-bundle"]),
  html:not(.student-pricing-bundle-access-allowed) .collection-list__item:has(a[href*="/collections/all-bundles"]),
  html:not(.student-pricing-bundle-access-allowed) .collection-list__item:has(a[href*="/collections/bundle"]),
  html:not(.student-pricing-bundle-access-allowed) .collection-card:has(a[href*="/collections/all-bundles"]),
  html:not(.student-pricing-bundle-access-allowed) .collection-card:has(a[href*="/collections/bundle"]),
  html:not(.student-pricing-bundle-access-allowed) [class*="collection-card"]:has(a[href*="/collections/all-bundles"]),
  html:not(.student-pricing-bundle-access-allowed) [class*="collection-card"]:has(a[href*="/collections/bundle"]) {
    display: none !important;
  }
</style>

{% unless customer %}
  {% if is_bundle_access_page %}
    <script>
      window.location.replace('/');
    </script>
  {% endif %}
{% endunless %}

<div
  id="student-pricing-config-{{ block.id }}"
  class="student-pricing-config"
  hidden
  data-endpoint="/apps/student-automatic-discount/proxy/student-pricing"
  data-bundle-access-endpoint="/apps/student-automatic-discount/proxy/bundle-access"
  data-protected-product-handles="primary-years-bundle"
  data-protected-collection-handles="bundle,all-bundles"
  data-shop="{{ shop.myshopify_domain }}"
  data-customer-id="{{ customer.id | default: '' }}"
  data-design-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
></div>

{% schema %}
{
  "name": "Student pricing preview",
  "target": "body",
  "stylesheet": "student-pricing.css",
  "javascript": "student-pricing.js",
  "settings": []
}
{% endschema %}
