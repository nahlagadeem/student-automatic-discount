<div
  id="student-pricing-config-{{ block.id }}"
  class="student-pricing-config"
  hidden
  data-endpoint="/apps/student-automatic-discount/proxy/student-pricing"
  data-bundle-access-endpoint="/apps/student-automatic-discount/proxy/bundle-access"
  data-protected-product-handles="primary-years-bundle"
  data-protected-collection-handles="bundle,all-bundles"
  data-shop="{{ shop.myshopify_domain }}"
  data-customer-id="{{ customer.id | default: '' }}"
  data-design-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
></div>

{% schema %}
{
  "name": "Student pricing preview",
  "target": "body",
  "stylesheet": "student-pricing.css",
  "javascript": "student-pricing.js",
  "settings": []
}
{% endschema %}
