{% if customer %}
  <div
    id="student-pricing-config-{{ block.id }}"
    class="student-pricing-config"
    hidden
    data-endpoint="{{ shop.secure_url }}/apps/student-automatic-discount/proxy/student-pricing"
    data-shop="{{ shop.permanent_domain }}"
    data-customer-id="{{ customer.id }}"
  ></div>
{% endif %}

{% schema %}
{
  "name": "Student pricing preview",
  "target": "body",
  "stylesheet": "student-pricing.css",
  "javascript": "student-pricing.js",
  "settings": []
}
{% endschema %}
